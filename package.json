{
  "name": "@emmorts/body-muscles",
  "version": "1.1.1",
  "description": "Interactive SVG body map with 70+ muscles, intensity visualization, and zero dependencies. Works with React, Vue, Svelte, or vanilla JS. Maintained fork of vulovix/body-muscles published as @emmorts/body-muscles.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "browser": "dist/umd/body-muscles.umd.min.js",
  "unpkg": "dist/umd/body-muscles.umd.min.js",
  "jsdelivr": "dist/umd/body-muscles.umd.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --module esnext --outDir dist/esm && node scripts/fix-esm-imports.js && node scripts/build-umd.js && node scripts/export-data.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "verify-build": "node scripts/verify-build.mjs",
    "test:browser": "node tests/browser-behavior.mjs",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "smooth-paths": "node scripts/smooth-raw-paths.ts",
    "export-data": "node scripts/export-data.js",
    "docs": "rm -rf docs/lib && mkdir -p docs/lib && cp dist/umd/body-muscles.umd.js docs/lib/body-muscles.umd.js && npx serve docs",
    "docs:build": "rm -rf docs/lib && mkdir -p docs/lib && cp dist/umd/body-muscles.umd.js docs/lib/body-muscles.umd.js",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "body-map",
    "body-muscles",
    "muscle-chart",
    "anatomy",
    "anatomical",
    "svg",
    "interactive-body-map",
    "muscle-visualization",
    "body-mapping",
    "fitness",
    "workout",
    "human-body",
    "typescript",
    "framework-agnostic",
    "vanilla-js",
    "react",
    "vue",
    "svelte",
    "zero-dependencies"
  ],
  "author": "vulovix",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "playwright": "^1.64.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emmorts/body-muscles.git"
  },
  "bugs": {
    "url": "https://github.com/emmorts/body-muscles/issues"
  },
  "homepage": "https://emmorts.github.io/body-muscles/"
}
